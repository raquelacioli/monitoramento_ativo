# Firestore: server-side only. Never commit the service-account JSON.
APP_ENV=production
FIREBASE_PROJECT_ID=monitoramentoativo
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_NAMESPACE=monitoramento_ativo
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
MONITORAMENTO_COOKIE_SECURE=1

# Render Free: recovery over HTTPS; configure an approved provider/account.
RECOVERY_EMAIL_PROVIDER=resend
RECOVERY_EMAIL_FROM=monitoramento@example.invalid
RESEND_API_KEY=replace-with-provider-api-key

# Alternative SMTP, only on hosts/plans that permit outgoing SMTP:
# RECOVERY_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=monitoramento@example.invalid

# Public HTTPS origin only; reset links are never built from request headers.
APP_BASE_URL=https://monitoramento.example.invalid
