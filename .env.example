# Copy to .env and configure only with credentials from an approved SMTP provider.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=monitoramento@example.invalid

# Public HTTPS origin only; reset links are never built from request headers.
APP_BASE_URL=https://monitoramento.example.invalid
